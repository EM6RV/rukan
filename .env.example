# ===== التطبيق =====
NODE_ENV=development
# الرابط الأساسي للتطبيق (يُستعمل لفحص Origin وروابط المشاركة)
APP_URL=http://localhost:3000
# الدومين الرئيسي. المتاجر تكون slug.ROOT_DOMAIN. للتطوير المحلي: localhost:3000
ROOT_DOMAIN=localhost:3000

# ===== قاعدة البيانات (Turso / libSQL) =====
# محلياً: ملف. في الإنتاج: libsql://اسم-القاعدة.turso.io
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# ===== تخزين الصور =====
# turso = داخل القاعدة | r2 = Cloudflare R2
STORAGE_DRIVER=turso
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ===== حساب أدمن المنصة (يُنشأ بالـ seed) =====
ADMIN_NAME=مدير رُكن
ADMIN_PHONE=0910000000
ADMIN_PASSWORD=غيّر-كلمة-السر-هذي

# ===== للتطوير فقط =====
# 1 = ينشئ متجر تجريبي بسيط (demo) مع الـ seed
SEED_DEMO=
