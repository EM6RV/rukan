# ===== التطبيق =====
NODE_ENV=development
# الرابط الأساسي للتطبيق (يُستعمل لفحص Origin وروابط المشاركة)
APP_URL=http://localhost:3000
# الدومين الرئيسي. المتاجر تكون slug.ROOT_DOMAIN. للتطوير المحلي: localhost:3000
ROOT_DOMAIN=localhost:3000

# ===== قاعدة البيانات (Turso / libSQL) =====
# محلياً: ملف. في الإنتاج: libsql://اسم-القاعدة.turso.io
DATABASE_URL=file:./data/dev.db
DATABASE_AUTH_TOKEN=

# ===== تخزين الصور =====
# turso = داخل القاعدة | r2 = Cloudflare R2
STORAGE_DRIVER=turso
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ===== إشعارات الطلبيات (Web Push) — اختيارية، شغّل: pnpm push:keys =====
# التحقق من الهاتف بكود عند التسجيل. off = مطفي (التسجيل يمشي بدون كود). sms | whatsapp لما يكون عندك مزود. console للتجربة المحلية (يطبع الكود في السيرفر)
PHONE_VERIFY_CHANNEL=off
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER=
WHATSAPP_OTP_TOKEN=
WHATSAPP_OTP_PHONE_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@rukn.ly

# ===== حساب أدمن المنصة (يُنشأ بالـ seed) =====
ADMIN_NAME=مدير رُكن
ADMIN_PHONE=0910000000
ADMIN_PASSWORD=غيّر-كلمة-السر-هذي

# ===== خلف البروكسي (الإنتاج) =====
# عدد البروكسيات الموثوقة قدام التطبيق (Render = 1). تُستعمل لقراءة IP العميل بأمان (حدود المحاولات).
TRUSTED_PROXY_HOPS=1
# 1 = لو Cloudflare قدام Render (يقرا cf-connecting-ip)
TRUST_CLOUDFLARE=
# هدف CNAME للدومينات الخاصة للبياعين (مثال: rukn.onrender.com). الافتراضي cname.ROOT_DOMAIN
CUSTOM_DOMAIN_TARGET=
# فحص الإنتاج الصارم محلياً: NODE_ENV=production STRICT_PRODUCTION=1 pnpm check:env
STRICT_PRODUCTION=
# 1 = السماح بقاعدة ملف محلية في الإنتاج (فقط لو عندك قرص دائم). غير ذلك استعمل Turso.
ALLOW_LOCAL_DB=

# ===== للتطوير فقط =====
# 1 = ينشئ متجر تجريبي بسيط (demo) مع الـ seed
SEED_DEMO=
